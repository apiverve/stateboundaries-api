            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "stateboundaries",
        "state boundaries api",
        "us state borders geojson",
        "get state boundary coordinates",
        "us state border polygon",
        "state fips code lookup"
    ],
    "homepage": "https://apiverve.com/marketplace/stateboundaries?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/stateboundaries",
        "source": "https://github.com/apiverve/stateboundaries-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
